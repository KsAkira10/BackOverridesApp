{
  "name": "@back-overrides/client",
  "version": "0.2.0",
  "description": "In-browser runtime and Service Worker interceptor for BackOverrides",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@back-overrides/core": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^18.14.2"
  }
}
