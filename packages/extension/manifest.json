{
  "manifest_version": 3,
  "name": "BackOverrides - Endpoint Redirector",
  "version": "0.7.0",
  "description": "Intercepta e redireciona endpoints específicos para localhost sem alterar URLs no frontend, com resolução automática de CORS.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BackOverrides"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
